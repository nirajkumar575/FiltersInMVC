@model FiltersInMVC.Models.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Login";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-light p-2 rounded">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index">Account</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            Login
        </li>
    </ol>
</nav>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <!-- Card for Login -->
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center">
                    <h3><i class="bi bi-box-arrow-in-right"></i> Login</h3>
                </div>
                <div class="card-body">
                    <div class="text-danger mb-2">@ViewBag.Error</div>

                    <form asp-action="Login" id="myForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Username -->
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-bold">
                                <i class="bi bi-person-fill"></i> Username
                            </label>
                            <input asp-for="Username" class="form-control" placeholder="Enter your username" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold">
                                <i class="bi bi-lock-fill"></i> Password
                            </label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <!-- Remember Me -->
                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label fw-bold">
                                 Remember Me
                            </label>
                        </div>
                        <!-- Buttons -->
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success w-50 me-2">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </button>
                            <button type="reset" class="btn btn-outline-secondary w-50" onclick="clearForm()">
                                <i class="bi bi-x-circle"></i> Clear
                            </button>
                        </div>
                    </form>

                    <hr />

                    <!-- Social Logins -->                    
                    <div class="row text-center">
                        <p class="fw-bold">Or</p>
                        <div class="col-md-4">
                            <a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Google"
                               class="btn btn-outline-danger w-100 mb-2">
                                <i class="bi bi-google"></i> Login with Google
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Account" asp-action="ExternalLogin"
                               asp-route-provider="Facebook" name="provider"
                               class="btn btn-outline-primary w-100 mb-2">
                                <i class="bi bi-facebook"></i> Login with Fb.
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="GitHub"
                               class="btn btn-outline-dark w-100">
                                <i class="bi bi-github"></i> Login with GitHub
                            </a>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Register / Back Links -->
            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-primary w-50 me-2"
                   asp-controller="Home" asp-action="Create">
                    <i class="bi bi-person-plus-fill"></i> Register
                </a>
                <a class="btn btn-outline-dark w-50"
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-arrow-left-circle"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>
    function clearForm() {
        document.getElementById("myForm").reset();
    }
</script>

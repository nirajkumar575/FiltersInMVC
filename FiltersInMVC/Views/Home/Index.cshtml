@model IEnumerable<FiltersInMVC.Models.User>

@{
    ViewData["Title"] = "User List";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- Breadcrumb -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-light p-2 rounded shadow-sm">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door-fill"></i> Home
            </a>
        </li>
        <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">
            <i class="bi bi-people-fill"></i> Users
        </li>
    </ol>
</nav>

<div class="container mt-4">
    <div class="card shadow-lg rounded-4">
        <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white rounded-top-4">
            <h4 class="mb-0">
                <i class="bi bi-people-fill"></i> User Management
            </h4>
            <a class="btn btn-success shadow-sm" asp-controller="Home" asp-action="Create">
                <i class="bi bi-person-plus-fill"></i> Add User
            </a>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th><i class="bi bi-person-fill"></i> @Html.DisplayNameFor(model => model.Username)</th>
                            <th><i class="bi bi-envelope-fill"></i> @Html.DisplayNameFor(model => model.Email)</th>
                            <th><i class="bi bi-telephone-fill"></i> @Html.DisplayNameFor(model => model.Phone)</th>
                            <th><i class="bi bi-gear-fill"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-center">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Username)</td>
                                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                                <td>
                                    <a class="btn btn-sm btn-warning shadow-sm me-1"
                                       asp-controller="Home" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>

                                    <a class="btn btn-sm btn-info shadow-sm text-white me-1"
                                       asp-controller="Home" asp-action="Details" asp-route-id="@item.Id">
                                        <i class="bi bi-info-circle-fill"></i> Details
                                    </a>

                                    <a class="btn btn-sm btn-danger shadow-sm"
                                       asp-controller="Home" asp-action="Delete" asp-route-id="@item.Id"
                                       onclick="return confirm('⚠️ Are you sure you want to delete this user?');">
                                        <i class="bi bi-trash-fill"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
